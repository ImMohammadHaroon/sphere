# Server
NODE_ENV=development
PORT=5000
# Comma-separated allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas or local
MONGO_URI=mongodb://localhost:27017/projectsphere

# JWT — use long random strings in production
JWT_SECRET=change-me-access-token-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-token-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Application-layer field encryption (AES-256-GCM)
ENCRYPTION_KEY=change-me-32-byte-hex-encryption-key!!

# Attachment file-at-rest encryption (AES-256-GCM). Must be a base64-encoded 32-byte key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# FILE_ENCRYPTION_KEY=<paste-generated-base64-key-here>

# Cookie settings (production cross-origin: COOKIE_SECURE=true, COOKIE_SAME_SITE=none)
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# Email (Gmail: enable 2FA, then create an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="ProjectSphere" <your-email@gmail.com>

# Scheduled jobs (daily expired refresh-token cleanup). Set to false to disable.
ENABLE_SCHEDULED_CLEANUP=true
