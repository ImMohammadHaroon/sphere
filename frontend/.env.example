# REST API base URL (include /api/v1 or omit — both work)
VITE_API_URL=http://localhost:5000

# Socket.io only works on a persistent Node host (Render, Railway, VPS).
# On Vercel serverless it is auto-disabled when the API URL contains vercel.app.
# Set to "true" only if you point VITE_SOCKET_URL at a non-Vercel WebSocket host.
# VITE_ENABLE_SOCKETS=false

# Optional separate host for Socket.io (e.g. Render) while REST stays on Vercel.
# VITE_SOCKET_URL=https://your-socket-host.onrender.com

# Stripe publishable key (test mode)
VITE_STRIPE_PUBLISHABLE_KEY=
